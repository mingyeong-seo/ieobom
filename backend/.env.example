APP_NAME="Ieobom API"
ENVIRONMENT=local
API_PREFIX=/api/v1

# Local fallback. For production use MySQL:
# DATABASE_URL=mysql+pymysql://ieobom:ieobom_password@mysql:3306/ieobom
DATABASE_URL=sqlite:///./ieobom.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional.
# - Empty: story generation uses a deterministic demo fallback.
# - Valid key: story generation calls the OpenAI Responses API.
# - Invalid key or API failure: API falls back to the demo summary so the MVP does not break.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini

DEMO_MODE=true
SEED_DEMO_DATA=true
